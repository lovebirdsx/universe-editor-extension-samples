{
  "name": "fsconsumer",
  "displayName": "FS Consumer",
  "description": "How to use the gated workspace.fs filesystem API in Universe Editor.",
  "version": "0.0.1",
  "publisher": "universe-samples",
  "license": "Apache-2.0",
  "type": "module",
  "icon": "icon.png",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "engines": {
    "universe": ">=0.12.0 <1.0.0"
  },
  "capabilities": {
    "untrustedWorkspaces": true
  },
  "files": [
    "dist",
    "icon.png"
  ],
  "activationEvents": [
    "onCommand:fsconsumer.run"
  ],
  "contributes": {
    "commands": [
      {
        "command": "fsconsumer.run",
        "title": "FS Consumer: Run"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "uex package",
    "e2e": "node ../../scripts/e2e/run.mjs fsconsumer",
    "universe:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@universe-editor/extension-api": "^0.12.0",
    "@universe-editor/uex": "^0.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
