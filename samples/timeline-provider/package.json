{
  "name": "timeline-provider",
  "displayName": "Timeline Provider",
  "description": "A Universe Editor extension sample that contributes a toy file timeline provider.",
  "version": "0.0.1",
  "publisher": "universe-samples",
  "license": "Apache-2.0",
  "type": "module",
  "icon": "icon.png",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "engines": {
    "universe": ">=0.12.0 <1.0.0"
  },
  "capabilities": {
    "untrustedWorkspaces": true
  },
  "files": [
    "dist",
    "icon.png"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "timeline-provider.refresh",
        "title": "Timeline Provider: Refresh Timeline"
      },
      {
        "command": "timeline-provider.inspectItem",
        "title": "Timeline Provider: Inspect Event"
      }
    ],
    "menus": {
      "timeline/item/context": [
        {
          "command": "timeline-provider.inspectItem",
          "when": "timelineItem == sample-timeline:event",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "uex package",
    "e2e": "node ../../scripts/e2e/run.mjs timeline-provider",
    "test": "vitest run",
    "universe:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@universe-editor/extension-api": "^0.12.0",
    "@universe-editor/uex": "^0.2.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.0"
  }
}
