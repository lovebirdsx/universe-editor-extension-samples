{
  "name": "product-icon-theme",
  "displayName": "Product Icon Theme",
  "description": "A pure-declarative Universe Editor extension sample: contributes.productIconThemes.",
  "version": "0.0.1",
  "publisher": "universe-samples",
  "license": "Apache-2.0",
  "type": "module",
  "icon": "icon.png",
  "categories": [
    "Other"
  ],
  "engines": {
    "universe": ">=0.12.0 <1.0.0"
  },
  "capabilities": {
    "untrustedWorkspaces": true
  },
  "files": [
    "themes",
    "icon.png"
  ],
  "contributes": {
    "productIconThemes": [
      {
        "id": "product-icon-theme-sample",
        "label": "Product Icon Theme Sample",
        "path": "./themes/product-icon-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "package": "uex package",
    "e2e": "node ../../scripts/e2e/run.mjs product-icon-theme",
    "universe:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@universe-editor/extension-api": "^0.12.0",
    "@universe-editor/uex": "^0.2.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.0"
  }
}
