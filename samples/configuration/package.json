{
  "name": "configuration",
  "displayName": "Configuration",
  "description": "How to contribute and use configuration in Universe Editor.",
  "version": "0.0.1",
  "publisher": "universe-samples",
  "license": "Apache-2.0",
  "type": "module",
  "icon": "icon.png",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "engines": {
    "universe": ">=0.12.0 <1.0.0"
  },
  "capabilities": {
    "untrustedWorkspaces": true
  },
  "files": [
    "dist",
    "icon.png"
  ],
  "activationEvents": [
    "onCommand:configuration.read"
  ],
  "contributes": {
    "configuration": {
      "title": "Configuration Sample",
      "properties": {
        "configuration.greeting": {
          "type": "string",
          "enum": [
            "Hello",
            "Hi",
            "Hey"
          ],
          "default": "Hello",
          "description": "The greeting the sample prints."
        },
        "configuration.showCount": {
          "type": "boolean",
          "default": true,
          "description": "Whether the sample prints a count line."
        }
      }
    },
    "commands": [
      {
        "command": "configuration.read",
        "title": "Configuration: Read"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "uex package",
    "universe:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@universe-editor/extension-api": "^0.12.0",
    "@universe-editor/uex": "^0.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
