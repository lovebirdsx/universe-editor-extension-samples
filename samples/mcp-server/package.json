{
  "name": "mcp-server",
  "displayName": "MCP Server",
  "description": "A Universe Editor extension sample that injects a toy stdio MCP server for agent sessions.",
  "version": "0.0.1",
  "publisher": "universe-samples",
  "license": "Apache-2.0",
  "type": "module",
  "icon": "icon.png",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "engines": {
    "universe": ">=0.12.0 <1.0.0"
  },
  "capabilities": {
    "untrustedWorkspaces": true
  },
  "files": [
    "dist",
    "server",
    "icon.png"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServers": {
      "sample-tools": {
        "command": "${execPath}",
        "args": [
          "${extensionPath}/server/index.mjs"
        ],
        "env": {
          "ELECTRON_RUN_AS_NODE": "1"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "uex package",
    "e2e": "node ../../scripts/e2e/run.mjs mcp-server",
    "test": "vitest run",
    "universe:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@universe-editor/extension-api": "^0.12.0",
    "@universe-editor/uex": "^0.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
