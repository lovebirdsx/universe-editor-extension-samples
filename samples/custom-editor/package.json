{
  "name": "custom-editor",
  "displayName": "Custom Editor",
  "description": "A Universe Editor extension sample that contributes a read-only custom editor for *.hexview files.",
  "version": "0.0.1",
  "publisher": "universe-samples",
  "license": "Apache-2.0",
  "type": "module",
  "icon": "icon.png",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "engines": {
    "universe": ">=0.12.0 <1.0.0"
  },
  "capabilities": {
    "untrustedWorkspaces": true
  },
  "files": [
    "dist",
    "icon.png"
  ],
  "activationEvents": [
    "onCustomEditor:custom-editor.hexView"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "custom-editor.hexView",
        "displayName": "Hex View",
        "selector": [
          {
            "filenamePattern": "*.hexview"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "uex package",
    "e2e": "node ../../scripts/e2e/run.mjs custom-editor",
    "test": "vitest run",
    "universe:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@universe-editor/extension-api": "^0.12.0",
    "@universe-editor/uex": "^0.2.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.0"
  }
}
