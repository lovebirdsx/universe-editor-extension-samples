{
  "name": "tree-view",
  "displayName": "Tree View",
  "description": "A Universe Editor extension sample that contributes a tree view inside a custom view container.",
  "version": "0.0.1",
  "publisher": "universe-samples",
  "license": "Apache-2.0",
  "type": "module",
  "icon": "icon.png",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "engines": {
    "universe": ">=0.12.0 <1.0.0"
  },
  "capabilities": {
    "untrustedWorkspaces": true
  },
  "files": [
    "dist",
    "icon.png"
  ],
  "activationEvents": [
    "onView:tree-view.dependencies"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tree-view.explorer",
          "title": "Dependencies",
          "icon": "$(list-tree)"
        }
      ]
    },
    "views": {
      "tree-view.explorer": [
        {
          "id": "tree-view.dependencies",
          "name": "Dependencies"
        }
      ]
    },
    "commands": [
      {
        "command": "tree-view.openDependency",
        "title": "Tree View: Open Dependency"
      },
      {
        "command": "tree-view.refreshEntry",
        "title": "Tree View: Refresh"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "uex package",
    "e2e": "node ../../scripts/e2e/run.mjs tree-view",
    "test": "vitest run",
    "universe:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@universe-editor/extension-api": "^0.12.0",
    "@universe-editor/uex": "^0.2.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.0"
  }
}
